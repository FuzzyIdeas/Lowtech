{
  "sourceLanguage": "en",
  "strings": {
    "%@ and %@": {
      "comment": "Joins a list of app names: the first placeholder is the names before the last one, separated by commas",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ and %2$@"
          }
        }
      }
    },
    "%@ are running and may be blocking %@. Allow %@ to connect to paddle.com and paddleapi.com in %@, then try again.": {
      "comment": "The first and last placeholders are a list of firewall apps like Little Snitch and Lulu, the others are the app name.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ are running and may be blocking %2$@. Allow %3$@ to connect to paddle.com and paddleapi.com in %4$@, then try again."
          }
        }
      }
    },
    "%@ is running and may be blocking %@. Allow %@ to connect to paddle.com and paddleapi.com in %@, then try again.": {
      "comment": "The first and last placeholders are the name of a firewall app like Little Snitch, the others are the app name.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ is running and may be blocking %2$@. Allow %3$@ to connect to paddle.com and paddleapi.com in %4$@, then try again."
          }
        }
      }
    },
    "3 days": {
      "comment": "Update check interval, after \"every\""
